{
  "name": "barca_final_project_pipeline",
  "max_concurrent_runs": 1,
  "queue": {
    "enabled": true
  },
  "trigger": {
    "pause_status": "UNPAUSED",
    "file_arrival": {
      "url": "/Volumes/barca_final_project/bronze/landing/events/",
      "min_time_between_triggers_seconds": 900,
      "wait_after_last_change_seconds": 60
    }
  },
  "tags": {
    "project": "barca_final_project",
    "source": "statsbomb_open_data"
  },
  "tasks": [
    {
      "task_key": "bronze_ingestion",
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>/final_project_module_4/barca_events/notebooks/01_bronze",
        "source": "WORKSPACE"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 30000
    },
    {
      "task_key": "silver_validation",
      "depends_on": [
        {
          "task_key": "bronze_ingestion"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>/final_project_module_4/barca_events/notebooks/02_silver",
        "source": "WORKSPACE"
      }
    },
    {
      "task_key": "gold_summary",
      "depends_on": [
        {
          "task_key": "silver_validation"
        }
      ],
      "notebook_task": {
        "notebook_path": "/Workspace/Users/<your-user>/final_project_module_4/barca_events/notebooks/03_gold",
        "source": "WORKSPACE"
      }
    }
  ]
}

